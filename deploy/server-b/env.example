# Container environment for landa-ai-rag on server B: documentation of the file that
# fetch-secrets.sh renders to /etc/landa-ai/ai-rag.env (0600 root). Never commit real values.
#
# Sources:  [secret] = AWS Secrets Manager JSON secret (AI_RAG_SECRET_ID), one key per variable
#           [ssm]    = SSM Parameter Store under AI_RAG_SSM_PATH (non-secret tunables; optional)
#           [compose]= pinned in docker-compose.yml `environment:`; do NOT set here (it is overridden)
# Production reads ONLY the process environment (AI_RAG_ENV=production): no .env file is read.
# Names and bounds: app/core/config.py. Commented lines show the code default; set only to override.
# Values must not contain a newline or a single quote (fetch-secrets.sh rejects them).

# ================================ required ======================================================
# [secret] asyncpg DSN to server A. Role landa_ai_rag (SEP-2). TLS verified against the mounted CA;
# the host must match the Postgres certificate SAN. URL-encode the password.
DATABASE_URL=postgresql://landa_ai_rag:<from-secrets-manager>@<server-a-private-dns>:5432/postgres?sslmode=verify-full&sslrootcert=/etc/landa-ai/tls/pg-ca.pem
# [ssm] Backend-to-AI auth. Production: hmac only (no static token accepted).
AI_RAG_AUTH_MODE=hmac
# [secret] Comma-separated "key_id:secret" pairs; key_id [A-Za-z0-9._-]{1,64}, unique; secret >= 16
# chars (use `openssl rand -hex 32`), no commas. Two pairs during rotation, e.g. kid-2026a:...,kid-2026b:...
# Server A sends ONE pair: AI_RAG_SERVICE_HMAC_KEY_ID + AI_RAG_SERVICE_HMAC_SECRET.
AI_RAG_SERVICE_HMAC_SECRETS=<kid>:<from-secrets-manager>
# [secret] Required by startup validation ONLY until SEP-1 #3 (signed URLs) removes the storage key.
SUPABASE_URL=https://<server-a-private-dns>:<kong-port>
SUPABASE_SERVICE_KEY=<from-secrets-manager>
# [ssm] Storage bucket the documents live in.
SUPABASE_STORAGE_BUCKET=landa-storage

# ================================ pinned by docker-compose.yml [compose] ========================
# AI_RAG_ENV=production                 environment; also baked into the image
# AI_RAG_HOST=0.0.0.0                   bind inside the container (host publishes 127.0.0.1:8010)
# AI_RAG_PORT=8010                      uvicorn port (nginx upstream + HEALTHCHECK use it)
# AI_RAG_WORKERS=1                      must stay 1: the HMAC replay cache is per process
# AI_RAG_PROXY_HEADERS=true             honour X-Forwarded-* from the trusted proxy
# AI_RAG_FORWARDED_ALLOW_IPS=172.30.10.2  nginx container IP (CIDR allowed); nothing else is trusted
# AI_RAG_KEEP_ALIVE_TIMEOUT_SECONDS=75  must exceed nginx upstream keepalive_timeout (60 s)

# ================================ auth (optional) ===============================================
# [secret] Static token; only read when AI_RAG_AUTH_MODE is token or token_or_hmac. Leave unset.
# AI_RAG_SERVICE_TOKEN=
# [ssm] Allowed |now - X-Landa-Timestamp| (30..900). Both servers must run chrony/NTP.
# AI_RAG_AUTH_CLOCK_SKEW_SECONDS=300
# [ssm] Replay-cache lifetime for X-Landa-Request-Id (60..3600); keep >= 2x clock skew.
# AI_RAG_AUTH_REPLAY_TTL_SECONDS=600

# ================================ lifecycle =====================================================
# [ssm] uvicorn drain window on SIGTERM (1..600); compose stop_grace_period must be larger.
# AI_RAG_SHUTDOWN_GRACE_SECONDS=60
# [ssm] /readyz DB ping timeout (100..10000 ms).
# AI_RAG_READINESS_DB_TIMEOUT_MS=1000

# ================================ concurrency limiters ==========================================
# [ssm] Concurrent provider (Gemini) calls (1..256).
# AI_RAG_MAX_CONCURRENT_PROVIDER_CALLS=8
# [ssm] Concurrent document index jobs (1..64); each holds a document in /tmp (tmpfs = RAM).
# AI_RAG_MAX_CONCURRENT_INDEX_JOBS=2
# [ssm] CPU worker pool for parsing (1..64); default min(4, cpu_count-1).
# AI_RAG_CPU_WORKERS=4
# [ssm] Wait for a limiter slot before answering 503 SERVICE_BUSY (100..600000 ms).
# AI_RAG_LIMITER_ACQUIRE_TIMEOUT_MS=30000
# [ssm] thread | process. Keep thread on Linux: the process pool uses fork (see RUNBOOK gaps).
# AI_RAG_EXTRACTION_EXECUTOR=thread

# ================================ deadlines (keep below the backend 600-900 s timeout) ==========
# [ssm] Whole-route deadline for chat (1000..3600000 ms).
# AI_RAG_CHAT_DEADLINE_MS=180000
# [ssm] Whole-route deadline for document indexing.
# AI_RAG_INDEX_DEADLINE_MS=585000
# [ssm] Whole-route deadline for lesson-author / IDM routes.
# AI_RAG_LESSON_AUTHOR_DEADLINE_MS=585000
# [ssm] Postgres command timeout (seconds).
# AI_RAG_DATABASE_COMMAND_TIMEOUT_SECONDS=600

# ================================ provider (Gemini) =============================================
# [ssm] Transport attempts per provider call (1..5).
# AI_RAG_PROVIDER_MAX_ATTEMPTS=2
# [ssm] Retry backoff base (0..30000 ms).
# AI_RAG_PROVIDER_RETRY_BASE_MS=1500
# [ssm] Retry backoff cap (0..60000 ms).
# AI_RAG_PROVIDER_RETRY_MAX_MS=8000
# [ssm] Cumulative wait on per-minute rate limits inside one IDM provider call (0..300000 ms).
# AI_RAG_PROVIDER_RATE_LIMIT_MAX_WAIT_MS=60000
# [ssm] Default provider request timeout (ms).
# AI_RAG_PROVIDER_REQUEST_TIMEOUT_MS=60000
# [ssm] Course Blueprint provider timeout (ms).
# AI_RAG_BLUEPRINT_PROVIDER_REQUEST_TIMEOUT_MS=300000
# [ssm] Stage-2 unit-content provider timeout (60001..300000 ms).
# AI_RAG_STAGED_LESSON_CONTENT_PROVIDER_TIMEOUT_MS=180000
# [ssm] Staged lesson workflow budget (<= 480000 ms).
# AI_RAG_STAGED_LESSON_WORKFLOW_TIMEOUT_MS=480000
# [ssm] Embedding batch size.
# AI_RAG_EMBEDDING_BATCH_SIZE=32
# [ssm] Generation temperature.
# AI_RAG_GENERATION_TEMPERATURE=0.2
# [ssm] Gemini 3.8 thinking level: low | medium | high.
# AI_RAG_GEMINI_38_THINKING_LEVEL=medium

# ================================ IDM pipeline ==================================================
# [ssm] Judge: off | observe | repair.
# AI_RAG_IDM_JUDGE_MODE=observe
# [ssm] W1 parallelism (1..8).
# AI_RAG_IDM_W1_PARALLELISM=4
# [ssm] Max sections (4..16).
# AI_RAG_IDM_MAX_SECTIONS=16
# [ssm] Per IDM provider call timeout (30000..300000 ms).
# AI_RAG_IDM_PROVIDER_CALL_TIMEOUT_MS=180000
# [ssm] Course/lesson workflow repair attempts.
# AI_RAG_COURSE_WORKFLOW_MAX_REPAIR_ATTEMPTS=2
# AI_RAG_LESSON_WORKFLOW_MAX_REPAIR_ATTEMPTS=2

# ================================ semantic review (CP4) =========================================
# [ssm] off | observe | repair.
# AI_RAG_SEMANTIC_REVIEW_MODE=off
# [ssm] Reviewer model; empty reuses the writer model.
# AI_RAG_SEMANTIC_REVIEW_MODEL=
# [ssm] Reviewer timeout (1000..120000 ms).
# AI_RAG_SEMANTIC_REVIEW_TIMEOUT_MS=60000
# [ssm] Reviewer max output tokens (512..8192).
# AI_RAG_SEMANTIC_REVIEW_MAX_OUTPUT_TOKENS=4096
# [ssm] Writer/evaluator/repair attempt ceiling per unit (2..8).
# AI_RAG_SEMANTIC_REVIEW_PROVIDER_ATTEMPT_CAP=8

# ================================ request / document limits =====================================
# [ssm] Max request body, general routes (bytes). nginx client_max_body_size is 25m.
# AI_RAG_MAX_REQUEST_BYTES=16777216
# [ssm] Max request body, course-skeleton / IDM routes (bytes, 24 MiB).
# AI_RAG_IDM_MAX_REQUEST_BYTES=25165824
# [ssm] Max downloaded document size (bytes); keep tmpfs size > concurrent jobs x this.
# AI_RAG_MAX_DOCUMENT_BYTES=52428800
# [ssm] Max PDF pages.
# AI_RAG_MAX_DOCUMENT_PAGES=1000
# [ssm] OOXML zip-bomb guards.
# AI_RAG_MAX_OOXML_UNCOMPRESSED_BYTES=209715200
# AI_RAG_MAX_OOXML_ENTRIES=10000
# AI_RAG_MAX_OOXML_COMPRESSION_RATIO=100
# [ssm] Max spreadsheet cells.
# AI_RAG_MAX_XLSX_CELLS=200000
# [ssm] LibreOffice .doc conversion timeout (5..600 s); only with the WITH_LIBREOFFICE=true image.
# AI_RAG_LIBREOFFICE_TIMEOUT_SECONDS=120

# ================================ chunking / retrieval tuning ===================================
# [ssm] Chunk size and overlap (chars).
# AI_RAG_CHUNK_MAX_CHARS=3200
# AI_RAG_CHUNK_OVERLAP_CHARS=350
# [ssm] Chat retrieval.
# AI_RAG_TOP_K=8
# AI_RAG_MAX_CONTEXT_CHARS=18000
# AI_RAG_RETRIEVAL_CANDIDATE_MULTIPLIER=4
# AI_RAG_RETRIEVAL_MIN_SCORE=0.25
# AI_RAG_RETRIEVAL_KEYWORD_MIN_SCORE=0.50
# AI_RAG_RETRIEVAL_MAX_CHUNKS_PER_DOCUMENT=4
# AI_RAG_MAX_USER_MESSAGE_CHARS=20000
# [ssm] Lesson-author retrieval.
# AI_RAG_LESSON_AUTHOR_TOP_K=24
# AI_RAG_LESSON_AUTHOR_MAX_CONTEXT_CHARS=32000
# AI_RAG_LESSON_AUTHOR_MAX_CHUNKS_PER_DOCUMENT=12
# AI_RAG_LESSON_AUTHOR_SCOPE_MAX_CHUNKS=48
# [ssm] Source map limits.
# AI_RAG_SOURCE_COVERAGE_CANONICAL_MAX_CHARS=1000000
# AI_RAG_SOURCE_MAP_ARCHITECT_CONTEXT_MAX_CHARS=48000

# ================================ planned by SEP-1 (NOT read by the code yet) ===================
# AI_RAG_DB_POOL_MIN / AI_RAG_DB_POOL_MAX          pool size (today fixed 1..8 in app/main.py startup)
# AI_RAG_DB_SSL_MODE + CA path                     today: sslmode/sslrootcert inside DATABASE_URL
# AI_RAG_DB_STATEMENT_CACHE_SIZE                   0 behind PgBouncer/Supavisor transaction mode
# (signed-URL storage) -> SUPABASE_URL / SUPABASE_SERVICE_KEY are removed from this file

# ================================ never set ====================================================
# NODE_ENV  legacy fallback for AI_RAG_ENV (warns); AI_RAG_ENV is pinned by compose.
