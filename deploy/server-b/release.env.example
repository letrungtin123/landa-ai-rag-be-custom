# Non-secret compose interpolation for server B. Install as /etc/landa-ai/release.env (0640 root).
# deploy.sh rewrites AI_RAG_IMAGE / AI_RAG_PREVIOUS_IMAGE on each release; edit the rest by hand.
# No secrets here: container secrets live in AI_RAG_ENV_FILE (rendered by fetch-secrets.sh).

# --- image ---------------------------------------------------------------------------------------
# ECR repository (no tag). Registry host = part before the first "/".
AI_RAG_IMAGE_REPO=<account-id>.dkr.ecr.<aws-region>.amazonaws.com/landa-ai-rag
# Image currently deployed: always an immutable "sha-<40-hex git sha>" tag or "@sha256:<digest>".
AI_RAG_IMAGE=<account-id>.dkr.ecr.<aws-region>.amazonaws.com/landa-ai-rag:sha-<git-sha>
# Last known-good image (rollback target), maintained by deploy.sh.
AI_RAG_PREVIOUS_IMAGE=
# nginx image pinned by digest: docker buildx imagetools inspect nginxinc/nginx-unprivileged:1.28-alpine
NGINX_IMAGE=nginxinc/nginx-unprivileged:1.28-alpine@sha256:7377697a821c131a924a7105fafbe7414db4e9fcc77a6f08f776f33f141ec3f8

# --- AWS / logging ---------------------------------------------------------------------------------
AWS_REGION=<aws-region>
# Log groups must exist (awslogs-create-group=false); set retention when creating them.
AI_RAG_LOG_GROUP=/landa/ai-rag/prod/app
NGINX_LOG_GROUP=/landa/ai-rag/prod/nginx
AI_RAG_LOG_STREAM_PREFIX=server-b

# --- TLS / files on the host -----------------------------------------------------------------------
# Name in the nginx certificate SAN and in the backend's AI_RAG_SERVICE_URL (origin only).
AI_RAG_TLS_SERVER_NAME=<server-b-private-dns>
AI_RAG_TLS_CERT_FILE=/etc/landa-ai/tls/server.crt
AI_RAG_TLS_KEY_FILE=/etc/landa-ai/tls/server.key
AI_RAG_INTERNAL_CA_FILE=/etc/landa-ai/tls/internal-ca.pem
AI_RAG_PG_CA_FILE=/etc/landa-ai/tls/pg-ca.pem
# Bind 8443 to the instance's private IP (or keep 0.0.0.0 and rely on the security group).
AI_RAG_TLS_BIND_ADDRESS=0.0.0.0
AI_RAG_ENV_FILE=/etc/landa-ai/ai-rag.env

# --- resources (defaults in docker-compose.yml) -----------------------------------------------------
AI_RAG_MEM_LIMIT=3g
AI_RAG_TMPFS_SIZE=512m
AI_RAG_STOP_GRACE_PERIOD=75s
NGINX_TMPFS_SIZE=256m
