NODE_ENV=development
PORT=8010

# Protected infrastructure. Fill locally and never commit real values.
DATABASE_URL=
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_STORAGE_BUCKET=landa-storage

# Internal backend-to-RAG token. Use a dedicated random token in production.
AI_RAG_SERVICE_TOKEN=

# Chunking and retrieval tuning.
AI_RAG_CHUNK_MAX_CHARS=3200
AI_RAG_CHUNK_OVERLAP_CHARS=350
AI_RAG_EMBEDDING_BATCH_SIZE=32
AI_RAG_DATABASE_COMMAND_TIMEOUT_SECONDS=600
AI_RAG_TOP_K=8
AI_RAG_MAX_CONTEXT_CHARS=18000
AI_RAG_RETRIEVAL_CANDIDATE_MULTIPLIER=4
AI_RAG_RETRIEVAL_MIN_SCORE=0.25
AI_RAG_RETRIEVAL_KEYWORD_MIN_SCORE=0.50
AI_RAG_RETRIEVAL_MAX_CHUNKS_PER_DOCUMENT=4
AI_RAG_LESSON_AUTHOR_TOP_K=24
AI_RAG_LESSON_AUTHOR_MAX_CONTEXT_CHARS=32000
AI_RAG_LESSON_AUTHOR_MAX_CHUNKS_PER_DOCUMENT=12
AI_RAG_LESSON_AUTHOR_SCOPE_MAX_CHUNKS=48
AI_RAG_MAX_USER_MESSAGE_CHARS=20000
AI_RAG_GENERATION_TEMPERATURE=0.2
